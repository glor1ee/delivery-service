[flake8]
ignore = E203, E266, W503, N807, N818, F401
max-line-length = 79
max-complexity = 18
select = B,C,E,F,W,T4,B9,Q0,N8,VNE
inline-quotes = double
exclude =
    **migrations
    .venv
    tests
per-file-ignores =
    delivery_service/settings/dev.py:E402,F403,F405
    delivery_service/settings/prod.py:F403,F405